# انسخ القيم التالية إلى قسم "Environment Variables" في لوحة تحكم
# JustRunMy.App (أو أي منصة أخرى) — لا تُنشر هذا الملف نفسه بأي قيم حقيقية

# توكن بوت الاستضافة الرئيسي من @BotFather (إجباري)
HOST_BOT_TOKEN=123456789:AAExampleTokenHere

# آيديات المشرفين مفصولة بفاصلة (إجباري لوجود لوحة تحكم مشرف)
ADMIN_IDS=111111111,222222222

# مسار بيانات التشغيل. في Railway استخدم Volume مركّبًا على /app/data.
DATA_DIR=/app/data

# اختياري — Railway يحقن PORT تلقائيًا عند استخدام healthcheck.
# PORT=8080
